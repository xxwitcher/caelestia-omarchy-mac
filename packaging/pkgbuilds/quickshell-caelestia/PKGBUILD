# Quickshell (git) installed side by side with the system quickshell, for Caelestia-Silicon.
# Based on the AUR quickshell-git PKGBUILD. Installs to /opt so Omarchy's own quickshell stays untouched.

_pkgname=quickshell
pkgname=quickshell-caelestia
pkgver=0.3.1.r21.g11ca60b
pkgrel=1
pkgdesc='Quickshell (git) in /opt, used by Caelestia-Silicon'
arch=(x86_64 aarch64)
url='https://git.outfoxxed.me/quickshell/quickshell'
options=(!strip)
license=('LGPL-3.0-only')
depends=(
  'qt6-declarative'
  'qt6-base'
  'jemalloc'
  'qt6-svg'
  'libpipewire'
  'libxcb'
  'wayland'
  'libdrm'
  'mesa'
  'cpptrace'
  'polkit'
)
makedepends=(
  'vulkan-headers'
  'spirv-tools'
  'qt6-shadertools'
  'wayland'
  'wayland-protocols'
  'cli11'
  'ninja'
  'cmake'
  'git'
)
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

_prefix=/opt/quickshell-caelestia

pkgver() {
  cd "$_pkgname"
  git describe --long --tags --abbrev=7 --exclude='*[a-zA-Z][a-zA-Z]*' \
    | sed -E 's/^[^0-9]*//;s/([^-]*-g)/r\1/;s/-/./g'
}

build() {
  cd "$_pkgname"
  cmake -GNinja -B build \
    -DCMAKE_BUILD_TYPE="RelWithDebInfo" \
    -DCMAKE_INSTALL_PREFIX="$_prefix" \
    -DDISTRIBUTOR="Caelestia-Silicon (package: $pkgname)" \
    -DINSTALL_QML_PREFIX=lib/qt6/qml

  cmake --build build
}

package() {
  cd "$_pkgname"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"

  install -dm755 "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/caelestia-qs" <<SH
#!/bin/sh
export QML_IMPORT_PATH="$_prefix/lib/qt6/qml\${QML_IMPORT_PATH:+:\$QML_IMPORT_PATH}"
exec $_prefix/bin/qs "\$@"
SH
  chmod 755 "$pkgdir/usr/bin/caelestia-qs"
}
