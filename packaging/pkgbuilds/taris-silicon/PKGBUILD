# Taris-Silicon: the Taris shell for Apple Silicon (Asahi Linux), built from xxwitcher/caelestia-silicon.
# Based on the AUR taris-shell-git PKGBUILD. Runs on quickshell-taris instead of quickshell-git,
# so any other quickshell stays installed.
#
# Set TARIS_SRC=/path/to/checkout/shell to build from a local working tree instead of the git remote.

_pkgname='taris-shell'
pkgname=taris-silicon
pkgver=2.5.0.r33.ga237751
pkgrel=1
pkgdesc='The Taris desktop shell for Apple Silicon (Asahi Linux)'
arch=('x86_64' 'aarch64')
url='https://github.com/xxwitcher/caelestia-silicon'
license=('GPL-3.0-only')
depends=(
    'taris-cli'
    'quickshell-taris'
    'glibc'
    'gcc-libs'

    # Brightness
    'ddcutil'
    'brightnessctl'

    # Services
    'libcava'
    'networkmanager'
    'lm_sensors'
    'aubio'
    'libpipewire'
    'libqalculate'
    'power-profiles-daemon'

    # Fonts
    'ttf-material-symbols-variable'
    'ttf-rubik-vf'
    'ttf-cascadia-code-nerd'

    # Icons (the shell resolves app icons through the GTK icon theme)
    'papirus-icon-theme'

    # Qt modules
    'qt6-base'
    'qt6-declarative'
    'qt6-imageformats'
    'qt6-m3shapes-git'

    # Taris-Silicon additions: agent terminal tab, fan control
    'qmltermwidget'
    'python'

    # Extra functionality
    'swappy'
    'fish'
    'bash'
)
optdepends=(
    'fprintd: fingerprint unlock for the lock screen'
    'mise: install the coding agent picked in Settings > Apps > Agent (install.sh installs it)'
)
makedepends=('git' 'cmake' 'ninja' 'qt6-shadertools')
provides=($_pkgname)
conflicts=($_pkgname $_pkgname-git)
if [[ -z $TARIS_SRC ]]; then
    source=("$pkgname::git+$url.git")
    sha256sums=('SKIP')
fi

_srcdir() {
    echo "${TARIS_SRC:-$srcdir/$pkgname/shell}"
}

pkgver() {
    cd "$(_srcdir)"
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
    cmake -S "$(_srcdir)" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/ \
        -DDISTRIBUTOR="Taris-Silicon (package: $pkgname)"
    cmake --build "$srcdir/build"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
    install -Dm644 "$(_srcdir)/LICENSE" "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
    install -Dm644 "$(_srcdir)/NOTICE" "$pkgdir"/usr/share/licenses/$pkgname/NOTICE
}
